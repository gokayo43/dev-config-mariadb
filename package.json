{
  "name": "dev-config-mariadb",
  "version": "0.1.0",
  "private": true,
  "description": "The MariaDB extension of @gokayo43/dev-config: one reusable workflow, for the two legacy repos whose database is MariaDB.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokayo43/dev-config-mariadb.git"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "test": "bun test",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@gokayo43/dev-config": "github:gokayo43/dev-config#602fca2f24341ef9c445b4a6f750e887cf156f37",
    "@types/bun": "1.3.14",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "lifecycle": "dev"
}
